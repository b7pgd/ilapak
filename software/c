    def write_event_log(self, message, level="INFO"):
        timestamp = datetime.now().strftime("%H:%M:%S")
        log_line = f"[{timestamp}] [{level}] {message}\n"

        def append():
            self.log_text.config(state="normal")
            self.log_text.insert("end", log_line)
            self.log_text.see("end")
            self.log_text.config(state="disabled")

        self.root.after(0, append)

    def set_status(self, text, color="green", detail=""):
        self.root.after(0, lambda: self._set_status(text, color, detail))

    def _set_status(self, text, color, detail):
        self.status_label.config(text="● " + text, foreground=color)
        self.detail_label.config(text=detail)

    def append_raw(self, text):
        if not text:
            return
        clean = normalize_text(text)
        self.root.after(0, lambda: self._append_raw(clean))

    def _append_raw(self, text):
        self.raw_text.config(state="normal")
        self.raw_text.insert("end", text)
        self.raw_text.see("end")
        self.raw_text.config(state="disabled")

    def clear_raw(self):
        self.raw_text.config(state="normal")
        self.raw_text.delete("1.0", "end")
        self.raw_text.config(state="disabled")

    def update_result(self, data):
        raw_fields = data.get("raw_fields", {})

        def update():
            for key, variable in self.fields.items():
                variable.set(raw_fields.get(key, ""))

        self.root.after(0, update)

    def restart_app(self):
        global running, listener, is_processing, capturing, finished

        running = False
        is_processing = False
        capturing = False
        finished = False

        if listener is not None:
            try:
                listener.stop()
            except Exception:
                pass
            listener = None

        self.root.destroy()

        if getattr(sys, 'frozen', False):
            subprocess.Popen([sys.executable] + sys.argv[1:])
        else:
            subprocess.Popen([sys.executable] + sys.argv)

        sys.exit(0)

    def ensure_listener_running(self):
        global listener, running
        running = True

        if listener is not None:
            try:
                listener.stop()
            except Exception:
                pass
            listener = None

        try:
            listener = keyboard.Listener(on_press=self.on_key_press)
            listener.start()
            self.write_event_log("Pynput Keyboard Hook berhasil diinisialisasi.", "SISTEM")
        except Exception as e:
            self.write_event_log(f"Gagal memulai Keyboard Hook: {e}", "ERROR")

    def monitor_usb_status(self):
        global capturing, last_data_time, running

        now = time.time()
        if capturing and last_data_time > 0 and (now - last_data_time > 5.0):
            self.write_event_log("Aliran data USB terhenti / macet! Periksa koneksi kabel USB.", "USB ERROR")
            self.set_status("USB WARNING", "red", "Data stalled. Did USB get disconnected?")

        self.root.after(3000, self.monitor_usb_status)

    def check_inactivity(self):
        global buffer, capturing, finished, last_data_time, is_processing

        if capturing and not finished and not is_processing and last_data_time > 0:
            elapsed = time.time() - last_data_time
            if elapsed > 1.5:
                current_text = "".join(buffer)
                if is_report_finished(current_text) or len(current_text) > 150:
                    finished = True
                    is_processing = True
                    self.process_report()

        self.root.after(500, self.check_inactivity)

    def on_key_press(self, key):
        global buffer, capturing, finished, last_data_time, running, is_processing

        if not running:
            return

        try:
            if key == keyboard.Key.esc:
                self.root.after(0, self.close_app)
                return False

            char = None
            if hasattr(key, "char") and key.char is not None:
                char = key.char
            elif key == keyboard.Key.enter:
                char = "\n"
            elif key == keyboard.Key.tab:
                char = "\t"

            if char is not None:
                last_data_time = time.time()

                if not capturing:
                    buffer.append(char)
                    temp = "".join(buffer)

                    if len(buffer) > 500:
                        buffer = buffer[-500:]

                    if is_report_start(temp):
                        capturing = True
                        finished = False
                        is_processing = False
                        self.set_status("RECEIVING DATA", "#0078D7", "MA160 report detected")
                        self.message_label.config(text="Receiving MA160 report...")
                        self.write_event_log("Header Laporan MA160 terdeteksi! Memulai pengambilan data...", "DATA")
                        self.clear_raw()

                        start_match = re.search(
                            r"\b(?:\d{2}-[A-Za-z]{3}-\d{4}|\d{2}-\d{2}-\d{4}|\d{2}/\d{2}/\d{4})\s+\d{2}:\d{2}(?:\:\d{2})?\b",
                            temp
                        )

                        if start_match:
                            valid_text = temp[start_match.start():]
                            buffer = list(valid_text)
                            self.append_raw(valid_text)
                        else:
                            sartorius_match = re.search(r"\bSartorius\b", temp, re.IGNORECASE)
                            if sartorius_match:
                                valid_text = temp[sartorius_match.start():]
                                buffer = list(valid_text)
                                self.append_raw(valid_text)
                            else:
                                has_result_match = re.search(r"\bHASIL\s+TIMBANGAN\b", temp, re.IGNORECASE)
                                if has_result_match:
                                    valid_text = temp[has_result_match.start():]
                                    buffer = list(valid_text)
                                    self.append_raw(valid_text)
                                else:
                                    buffer = list(temp)
                                    self.append_raw(temp)
                else:
                    buffer.append(char)
                    self.append_raw(char)
                    current = "".join(buffer)

                    if is_report_finished(current) and not finished and not is_processing:
                        finished = True
                        is_processing = True
                        self.root.after(800, self.process_report)

            elif key == keyboard.Key.backspace:
                if capturing and buffer:
                    buffer.pop()
                    self.root.after(0, self.remove_last_raw)

        except Exception as e:
            self.write_event_log(f"Gagal membaca masukan tombol: {e}", "ERROR")
            self.set_status("ERROR", "red", str(e))

    def remove_last_raw(self):
        try:
            self.raw_text.config(state="normal")
            current = self.raw_text.get("1.0", "end-1c")
            if current:
                self.raw_text.delete("1.0", "end")
                self.raw_text.insert("end", current[:-1])
            self.raw_text.config(state="disabled")
        except Exception:
            pass

    def process_report(self):
        global buffer, capturing, finished, last_report_data, is_processing

        if not buffer:
            is_processing = False
            return

        raw_text_data = "".join(buffer)
        normalized_text = normalize_text(raw_text_data)

        print("\n" + "=" * 70 + "\nREPORT RAW\n" + "=" * 70)
        print(raw_text_data)
        print("=" * 70)

        if len(normalized_text.strip()) < 30:
            self.set_status("ERROR", "red", "Report terlalu pendek")
            self.write_event_log("Laporan tidak lengkap diterima (Panjang < 30 karakter).", "ERROR")
            buffer = []
            capturing = False
            finished = False
            is_processing = False
            return

        self.set_status("PROCESSING", "#FF9800", "Parsing MA160 report...")

        try:
            data = parse_report(normalized_text)

            valid_count = sum(1 for value in data["raw_fields"].values() if value and str(value).strip())
            print(f"VALID FIELD COUNT: {valid_count}")

            if valid_count >= 3:
                last_report_data = data
                self.update_result(data)

                self.set_status("REPORT READY", "green", "Data received. Ready to save PDF.")
                self.message_label.config(text="Log finished. Press SAVE PDF to export report.")
                self.write_event_log("Laporan berhasil diproses! Klik Save PDF", "SUKSES")
            else:
                raise Exception(f"Parser gagal membaca report ({valid_count} field terbaca)")

        except Exception as e:
            self.set_status("ERROR", "red", str(e))
            self.write_event_log(f"Gagal Memproses Laporan: {str(e)}", "ERROR")
            messagebox.showerror("MA160 Error", str(e))

        finally:
            buffer = []
            capturing = False
            finished = False
            is_processing = False

    def save_pdf(self):
        global last_report_data, last_save_time

        now = time.time()
        # Mencegah duplikasi save PDF jika dipanggil berulang dalam waktu singkat (< 2 detik)
        if now - last_save_time < 2.0:
            return
        last_save_time = now

        if not last_report_data:
            messagebox.showinfo("MA160", "Belum ada report data untuk disimpan.")
            return

        try:
            pdf_file = create_pdf(last_report_data)
            self.message_label.config(text=f"PDF saved: {pdf_file}")
            self.set_status("PDF SAVED", "green", "Report stored successfully")
            self.write_event_log(f"Dokumen PDF berhasil dibuat: {os.path.basename(pdf_file)}", "INFO")

            try:
                os.startfile(pdf_file)
            except Exception:
                pass

        except Exception as e:
            self.write_event_log(f"Gagal Membuat Dokumen PDF: {e}", "ERROR")
            messagebox.showerror("PDF ERROR", str(e))

    def open_folder(self, folder):
        try:
            os.startfile(folder)
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def update_clock(self):
        self.clock_label.config(text=datetime.now().strftime("%d-%m-%Y %H:%M:%S"))
        self.root.after(1000, self.update_clock)

    def close_app(self):
        global running, listener, is_processing

        running = False
        is_processing = False
        if listener:
            try:
                listener.stop()
            except Exception:
                pass
            listener = None

        self.root.destroy()

def main():
    root = tk.Tk()
    app = MA160App(root)
    root.mainloop()

if __name__ == "__main__":
    main()
