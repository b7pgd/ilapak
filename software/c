def compact_label(value):
    if not value:
        return ""
    return re.sub(r"\s+", "", value).lower()

def repair_labels(text):
    if not text:
        return ""

    labels = [
        "Measurement compl.",
        "Measurement complete",
        "Measurement time",
        "Final weight",
        "Final result",
        "Start weight",
        "Start time",
        "Result display",
        "Target value",
        "Initial weight",
        "Tolerance",
        "Standby",
        "Temperature",
        "Type",
        "Result",
        "Method name",
        "End",
    ]

    for label in labels:
        words = label.split()
        if len(words) > 1:
            label_pattern = r"\s*".join(re.escape(word) for word in words)
        else:
            label_pattern = re.escape(label)

        text = re.sub(
            r"([A-Za-z0-9°%+'g])(?=" + label_pattern + r"(?:\s|:|$))",
            r"\1\n",
            text,
            flags=re.IGNORECASE
        )

    return text

def normalize_text(text):
    if not text:
        return ""

    text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\x00", "")

    replacements = {
        "'ÇC": "°C",
        "'CÇ": "°C",
        "ÇC": "°C",
        "Â°C": "°C",
        "Ã‚Â°": "°",
        "Ã‡": "°",
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    text = re.sub(r"[^\x09\x0A\x0D\x20-\x7E°±']", "", text)
    text = repair_labels(text)

    return text

def is_report_start(text):
    if not text:
        return False

    text_norm = normalize_text(text)
    patterns = [
        r"\b\d{2}-[A-Za-z]{3}-\d{4}\s+\d{2}:\d{2}\b",
        r"\b\d{2}-\d{2}-\d{4}\s+\d{2}:\d{2}\b",
        r"\b\d{2}/\d{2}/\d{4}\s+\d{2}:\d{2}\b",
        r"\bSartorius\b",
        r"\bMod\.\s*MA160\b",
        r"\bHASIL\s+TIMBANGAN\b",
    ]

    for pattern in patterns:
        if re.search(pattern, text_norm, re.IGNORECASE):
            return True

    return False

def is_report_finished(text):
    if not text:
        return False

    text_norm = normalize_text(text)
    patterns = [
        r"(?im)^\s*Measurement\s*compl\.\s*$",
        r"(?im)^\s*Measurement\s*complete\s*$",
        r"Measurement\s*compl\.",
        r"Measurement\s*complete",
    ]

    for pattern in patterns:
        if re.search(pattern, text_norm, re.IGNORECASE):
            return True

    return False

def build_label_pattern(label):
    parts = label.split()
    if len(parts) == 1:
        return re.escape(parts[0])
    return r"\s*".join(re.escape(part) for part in parts)

def is_known_label_line(line):
    if not line:
        return False

    stripped = line.strip()
    if not stripped:
        return False

    for label in FIELD_LABELS:
        pattern = build_label_pattern(label)
        if re.fullmatch(r"\s*" + pattern + r"\s*:?\s*", stripped, re.IGNORECASE):
            return True

    device_labels = ["Mod.", "Model", "SerNo.", "Serial", "BAC", "APC", "MCU", "Name:"]
    for label in device_labels:
        if re.fullmatch(r"\s*" + re.escape(label) + r"\s*", stripped, re.IGNORECASE):
            return True

    return False

def get_field(text, label):
    if not text:
        return ""

    lines = text.splitlines()
    label_pattern = build_label_pattern(label)

    label_only_re = re.compile(r"^\s*" + label_pattern + r"\s*:?\s*$", re.IGNORECASE)
    label_value_re = re.compile(r"^\s*" + label_pattern + r"\s*:?\s*(.*?)\s*$", re.IGNORECASE)

    for i, line in enumerate(lines):
        if label_only_re.match(line):
            for j in range(i + 1, min(i + 5, len(lines))):
                candidate = lines[j].strip()
                if not candidate:
                    continue
                if is_known_label_line(candidate) or re.fullmatch(r"-+", candidate):
                    break
                return candidate
            continue

        match = label_value_re.match(line)
        if match:
            value = match.group(1).strip()
            if value:
                return value

            for j in range(i + 1, min(i + 5, len(lines))):
                candidate = lines[j].strip()
                if not candidate:
                    continue
                if is_known_label_line(candidate) or re.fullmatch(r"-+", candidate):
                    break
                return candidate

    return ""

def get_device_field(text, label):
    if not text:
        return ""

    lines = text.splitlines()
    escaped = re.escape(label)
    same_line_re = re.compile(r"^\s*" + escaped + r"\s*:?\s*(.*?)\s*$", re.IGNORECASE)

    for i, line in enumerate(lines):
        match = same_line_re.match(line)
        if not match:
            continue

        value = match.group(1).strip()
        if value:
            return value

        for j in range(i + 1, min(i + 4, len(lines))):
            candidate = lines[j].strip()
            if not candidate:
                continue
            if is_known_label_line(candidate) or re.fullmatch(r"-+", candidate):
                break
            return candidate

    return ""

def extract_header_datetime(text):
    if not text:
        return "", ""

    patterns = [
        r"\b(\d{2}-[A-Za-z]{3}-\d{4})\s+(\d{2}:\d{2}(?::\d{2})?)\b",
        r"\b(\d{2}-\d{2}-\d{4})\s+(\d{2}:\d{2}(?::\d{2})?)\b",
        r"\b(\d{2}/\d{2}/\d{4})\s+(\d{2}:\d{2}(?::\d{2})?)\b",
    ]

    for pattern in patterns:
        match = re.search(pattern, text)
        if match:
            return match.group(1), match.group(2)

    return "", ""

def clean_weight(value):
    if not value:
        return ""

    value = re.sub(r"\s+", " ", value.strip())
    match = re.search(r"([+-])\s*(\d+(?:\.\d+)?)\s*g\b", value, re.IGNORECASE)
    if match:
        return f"{match.group(1)} {match.group(2)} g"

    return value

def clean_temperature(value):
    if not value:
        return ""

    value = value.strip()
    match = re.search(r"([+-]?\d+(?:\.\d+)?)\s*(?:°C|'C|C|°)?", value, re.IGNORECASE)
    if match:
        return f"{match.group(1)} 'C"

    return value

def clean_result(value):
    if not value:
        return ""

    value = value.strip()
    match = re.search(r"([+-]?\s*\d+(?:\.\d+)?)\s*%M", value, re.IGNORECASE)
    if match:
        number = match.group(1).replace(" ", "")
        return f"{number} %M"

    return value

def clean_measurement_time(value):
    if not value:
        return ""

    value = value.strip()
    match = re.search(r"(\d{1,2}:\d{2})\s*min", value, re.IGNORECASE)
    if match:
        return f"{match.group(1)} min"

    return value

def clean_start_time(value):
    if not value:
        return ""

    value = value.strip()
    match = re.search(r"\b(\d{1,2}:\d{2}(?::\d{2})?)\b", value)
    if match:
        return match.group(1)

    return value

def parse_report(text):
    text = normalize_text(text)

    print("\n" + "=" * 70 + "\nPARSER INPUT\n" + "=" * 70)
    print(text)
    print("=" * 70)

    data = {
        "brand": "Sartorius",
        "method": "",
        "device": [],
        "measurement": [],
        "raw_fields": {}
    }

    header_date, header_time = extract_header_datetime(text)
    data["raw_fields"]["date"] = header_date
    data["raw_fields"]["time"] = header_time
    data["instrument_datetime"] = f"{header_date} {header_time}" if header_date and header_time else ""

    model = get_device_field(text, "Mod.") or get_device_field(text, "Model")
    serial = get_device_field(text, "SerNo.") or get_device_field(text, "Serial")
    bac = get_device_field(text, "BAC")
    apc = get_device_field(text, "APC")
    mcu = get_device_field(text, "MCU")

    model, serial, bac, apc, mcu = model.strip(), serial.strip(), bac.strip(), apc.strip(), mcu.strip()

    data["raw_fields"]["model"] = model
    data["raw_fields"]["serial"] = serial
    data["raw_fields"]["bac"] = bac
    data["raw_fields"]["apc"] = apc
    data["raw_fields"]["mcu"] = mcu

    if model:
        data["device"].append(["Mod.", model])
    if serial:
        data["device"].append(["SerNo.", serial])
    if bac:
        data["device"].append(["BAC", bac])
    if apc:
        data["device"].append(["APC", apc])
    if mcu:
        data["device"].append(["MCU", mcu])

    method = get_field(text, "Method name")
    data["method"] = method
    data["raw_fields"]["method"] = method

    type_val = get_field(text, "Type")
    if compact_label(type_val) == "standarddrying":
        type_val = "Standard drying"
    data["raw_fields"]["type"] = type_val

    temperature = clean_temperature(get_field(text, "Temperature"))
    data["raw_fields"]["temperature"] = temperature

    standby = get_field(text, "Standby")
    initial_weight = get_field(text, "Initial weight")
    tolerance = get_field(text, "Tolerance")
    end_value = get_field(text, "End")
    result_display = get_field(text, "Result display")
    target = get_field(text, "Target value")

    data["raw_fields"]["standby"] = standby
    data["raw_fields"]["initial_weight"] = initial_weight
    data["raw_fields"]["tolerance"] = tolerance
    data["raw_fields"]["end"] = end_value
    data["raw_fields"]["result_display"] = result_display
    data["raw_fields"]["target"] = target

    start_time = clean_start_time(get_field(text, "Start time"))
    data["raw_fields"]["start_time"] = start_time

    start_weight = clean_weight(get_field(text, "Start weight"))
    data["raw_fields"]["start_weight"] = start_weight

    measurement_time = clean_measurement_time(get_field(text, "Measurement time"))
    data["raw_fields"]["measurement_time"] = measurement_time

    result = clean_result(get_field(text, "Result"))
    data["raw_fields"]["result"] = result

    final_weight = clean_weight(get_field(text, "Final weight"))
    data["raw_fields"]["final_weight"] = final_weight

    completed = is_report_finished(text)
    data["raw_fields"]["completed"] = "YES" if completed else "NO"

    if type_val:
        data["measurement"].append(["Type", type_val])
    if temperature:
        data["measurement"].append(["Temperature", temperature])
    if start_time:
        data["measurement"].append(["Start time", start_time])
    if start_weight:
        data["measurement"].append(["Start weight", start_weight])
    if measurement_time:
        data["measurement"].append(["Measurement time", measurement_time])
    if result:
        data["measurement"].append(["Result", result])
    if final_weight:
        data["measurement"].append(["Final weight", final_weight])
    if completed:
        data["measurement"].append(["Measurement compl.", ""])

    return data

def create_pdf(parsed):
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"hasil_timbangan_{timestamp}.pdf"
    filepath = os.path.join(OUTPUT_DIR, filename)

    doc = SimpleDocTemplate(
        filepath,
        pagesize=A4,
        rightMargin=40,
        leftMargin=40,
        topMargin=40,
        bottomMargin=30
    )

    elements = []
    styles = getSampleStyleSheet()

    title = Paragraph("<b>HASIL TIMBANGAN</b>", styles["Title"])
    elements.append(title)
    elements.append(Spacer(1, 15))

    table_data = []

    pdf_created_time = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    table_data.append(["Tanggal", pdf_created_time])

    for row in parsed.get("device", []):
        table_data.append(row)

    table_data.append(["--------------------------------------------------", ""])
    separator_row = len(table_data) - 1

    for row in parsed.get("measurement", []):
        if row[0] == "Measurement compl.":
            table_data.append(["Measurement compl.", ""])
        else:
            table_data.append(row)

    last_row = len(table_data) - 1

    style_rules = [
        ("GRID", (0, 0), (-1, -1), 1, colors.black),
        ("FONTNAME", (0, 0), (-1, -1), "Helvetica"),
        ("FONTSIZE", (0, 0), (-1, -1), 12),
        ("TOPPADDING", (0, 0), (-1, -1), 8),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 8),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("FONTNAME", (0, 0), (1, 0), "Helvetica-Bold"),
        ("SPAN", (0, separator_row), (1, separator_row)),
        ("ALIGN", (0, separator_row), (1, separator_row), "CENTER"),
    ]

    if table_data and table_data[last_row][0] == "Measurement compl.":
        style_rules.extend([
            ("SPAN", (0, last_row), (1, last_row)),
            ("ALIGN", (0, last_row), (1, last_row), "CENTER"),
            ("FONTNAME", (0, last_row), (1, last_row), "Helvetica-Bold"),
        ])

    table = Table(table_data, colWidths=[220, 260])
    table.setStyle(TableStyle(style_rules))

    elements.append(table)
    doc.build(elements)

    return filepath

