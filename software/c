        self.last_usb_check_time = time.time()
        self.usb_connected = True

        self.setup_style()
        self.create_gui()
        self.update_clock()
        self.check_inactivity()
        self.monitor_usb_status()

        self.ensure_listener_running()

        self.write_event_log("Sistem aktif. Silahkan Klik Tombol Print pada alat MA...", "INFO")
        self.append_raw("[INFO] Sistem aktif. Silahkan Klik Tombol Print pada alat MA...\n")

        self.root.protocol("WM_DELETE_WINDOW", self.close_app)

